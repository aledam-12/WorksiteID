{
  "name": "sanctions",
  "version": "2.0",
  "description": "FireFly Interface (FFI) for WorksiteID privacy-preserving sanctions chaincode",
  "methods": [
    {
      "name": "CreateLicense",
      "description": "Crea lo stato pubblico iniziale di una patente utilizzando un riferimento opaco e un commitment dello stato privato",
      "params": [
        {
          "name": "licenseRef",
          "schema": {
            "type": "string",
            "description": "Riferimento opaco e pseudonimo della patente"
          }
        },
        {
          "name": "initialCommitment",
          "schema": {
            "type": "string",
            "description": "Commitment crittografico dello stato privato iniziale della patente"
          }
        }
      ],
      "returns": []
    },
    {
      "name": "GetLicenseState",
      "description": "Recupera lo stato pubblico della patente dal ledger senza esporre dati privati",
      "params": [
        {
          "name": "licenseRef",
          "schema": {
            "type": "string",
            "description": "Riferimento opaco e pseudonimo della patente"
          }
        }
      ],
      "returns": [
        {
          "name": "licenseState",
          "schema": {
            "type": "object",
            "description": "Stato pubblico della patente memorizzato sul ledger",
            "properties": {
              "licenseRef": {
                "type": "string",
                "description": "Riferimento opaco della patente"
              },
              "commitment": {
                "type": "string",
                "description": "Commitment crittografico dello stato privato"
              },
              "version": {
                "type": "integer",
                "description": "Versione progressiva dello stato pubblico"
              }
            },
            "required": [
              "licenseRef",
              "commitment",
              "version"
            ]
          }
        }
      ]
    },
    {
      "name": "IssueSanction",
      "description": "Registra una sanzione tramite commitment e aggiorna il commitment pubblico della patente senza esporre penalty, motivazione o altri dati privati",
      "params": [
        {
          "name": "sanctionID",
          "schema": {
            "type": "string",
            "description": "Identificativo univoco della sanzione"
          }
        },
        {
          "name": "licenseRef",
          "schema": {
            "type": "string",
            "description": "Riferimento opaco e pseudonimo della patente"
          }
        },
        {
          "name": "sanctionCommitment",
          "schema": {
            "type": "string",
            "description": "Commitment crittografico dei dati privati della sanzione"
          }
        },
        {
          "name": "newCommitment",
          "schema": {
            "type": "string",
            "description": "Commitment crittografico del nuovo stato privato della patente"
          }
        },
        {
          "name": "inspectorRef",
          "schema": {
            "type": "string",
            "description": "Riferimento pseudonimo dell'ispettore"
          }
        }
      ],
      "returns": []
    },
    {
      "name": "GetSanction",
      "description": "Recupera i metadati pubblici e il commitment di una sanzione dal ledger senza esporre i dati privati",
      "params": [
        {
          "name": "sanctionID",
          "schema": {
            "type": "string",
            "description": "Identificativo della sanzione da recuperare"
          }
        }
      ],
      "returns": [
        {
          "name": "sanction",
          "schema": {
            "type": "object",
            "description": "Metadati pubblici della sanzione",
            "properties": {
              "id": {
                "type": "string",
                "description": "Identificativo della sanzione"
              },
              "licenseRef": {
                "type": "string",
                "description": "Riferimento opaco della patente"
              },
              "sanctionCommitment": {
                "type": "string",
                "description": "Commitment crittografico dei dati privati della sanzione"
              },
              "issuedAt": {
                "type": "string",
                "format": "date-time",
                "description": "Timestamp della transazione Fabric"
              },
              "inspectorRef": {
                "type": "string",
                "description": "Riferimento pseudonimo dell'ispettore"
              },
              "version": {
                "type": "integer",
                "description": "Versione dello stato della patente risultante dalla sanzione"
              }
            },
            "required": [
              "id",
              "licenseRef",
              "sanctionCommitment",
              "issuedAt",
              "inspectorRef",
              "version"
            ]
          }
        }
      ]
    }
  ],
  "events": []
}