# ============================================================
# Application
# ============================================================
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# ============================================================
# MySQL
# ============================================================
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=worksiteid
DB_USER=root
DB_PASSWORD=

# ============================================================
# FireFly / Hyperledger Fabric
# ============================================================
FIREFLY_URL=http://127.0.0.1:5001
FIREFLY_API_URL=http://127.0.0.1:5001
FIREFLY_NAMESPACE=default
FIREFLY_API_NAME=sanction_contract
FIREFLY_ISSUER_ID=worksiteid-issuer

# ============================================================
# WebAuthn
# ============================================================
RP_ID=localhost
ORIGIN=http://localhost:3000

# ============================================================
# License Reference
# ============================================================
# HMAC-SHA256 secret to derive opaque licenseRef from licenseId
# Mandatory in production environment.
LICENSE_REF_SECRET=

# ============================================================
# ZKP Groth16 Artifacts
# ============================================================
ZKP_VERIFICATION_KEY_PATH=./zkp/build/verification_key.json
ZKP_WASM_PATH=./zkp/build/license_verification_js/license_verification.wasm
ZKP_ZKEY_PATH=./zkp/build/license_verification_final.zkey

# ============================================================
# VC Issuer (Ed25519 Keys)
# ============================================================
# Generate with: npm run keys:generate
VC_ISSUER_PRIVATE_KEY_PATH=./secrets/issuer-private-key.pem
VC_ISSUER_PUBLIC_KEY_PATH=./secrets/issuer-public-key.pem
VC_ISSUER_ID=worksiteid-issuer
